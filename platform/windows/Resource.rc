// Microsoft Visual C++ generated resource script.
//
#include "resource.h"

// Pulls in the Windows resource macros this script relies on — LANG_ENGLISH /
// SUBLANG_ENGLISH_UK, VS_VERSION_INFO, VERSIONINFO, BLOCK, VALUE, the FILEOS/FILETYPE
// flags, etc. Without it every one of those is undefined and the resource compiler
// (rc.exe or windres) fails with "PRIMARY LANGUAGE ID not a number",
// "file not found: VS_VERSION_INFO", "unexpected value in RCDATA", and so on.
#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
// English (United Kingdom) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENG)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_UK
#pragma code_page(1252)

#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE 
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE 
BEGIN
    "\0"
END

3 TEXTINCLUDE 
BEGIN
    "\r\n"
    "\0"
END

#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
// avp_multi.ico carries 16/24/32/48/64/128/256 32bpp images (built from the
// 256x256 art in source/src/avp.icns), so Explorer, the taskbar, alt-tab and
// Steam pick a native size instead of upscaling the old single 32x32 8-bit
// icon (which is what looked blocky). That original is kept alongside.
IDI_ICON1               ICON                    "avp_multi.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,0,0
 PRODUCTVERSION 0,7,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Bassquake"
            /* CMake defines AVP_PCVR for the OpenXR/SteamVR target and passes it
               through to the resource compiler, so the two Windows exes that share
               this script identify themselves apart in Task Manager / Explorer's
               Description column. */
#ifdef AVP_PCVR
            VALUE "FileDescription", "Aliens Versus Predator: VR"
#else
            VALUE "FileDescription", "Aliens Versus Predator"
#endif
            VALUE "FileVersion", "0.7.0.0"
            VALUE "InternalName", "avp.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "avp.exe"
            VALUE "ProductName", "Aliens versus Predator"
            VALUE "ProductVersion", "0.7.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END

#endif    // English (United Kingdom) resources
/////////////////////////////////////////////////////////////////////////////



#ifndef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// Generated from the TEXTINCLUDE 3 resource.
//


/////////////////////////////////////////////////////////////////////////////
#endif    // not APSTUDIO_INVOKED

